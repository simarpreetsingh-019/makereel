# Copy to .env (never commit .env). Real environment variables override this file.
# Every option is explained in docs/CONFIGURATION.md.

# Where things live
MAKEREEL_CONFIG=makereel.json          # user settings (channels, limits, reel options)
MAKEREEL_OUTPUT_DIR=output             # one folder per video, reels inside
MAKEREEL_WORK_DIR=downloads            # temporary downloads and live buffers
MAKEREEL_DATA_DIR=data                 # brand kit (logo, fonts) and benchmark history

# Web app
MAKEREEL_HOST=127.0.0.1                # 0.0.0.0 to reach it from other devices (needs a password)
MAKEREEL_PORT=8765                     # PORT also works (hosting services set it)
MAKEREEL_WEB_PASSWORD=                 # required when MAKEREEL_HOST is not local
MAKEREEL_ALLOWED_ORIGINS=              # comma-separated sites allowed to call this engine (hosted UI)

# Performance
MAKEREEL_THREADS=2                     # CPU threads for speech-to-text and x264
MAKEREEL_ENCODER=                      # force: h264_videotoolbox | h264_nvenc | h264_qsv | h264_amf | libx264
MAKEREEL_FFMPEG_DIR=                   # folder with an ffmpeg that has libass, if not found automatically

MAKEREEL_REPO_URL=                     # e.g. https://github.com/you/makereel: enables 'Share benchmark' (pre-filled issue)

MAKEREEL_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
